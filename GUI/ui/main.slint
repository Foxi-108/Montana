import { LineEdit, Slider, ListView } from "std-widgets.slint";

// ==================================================
// DATA STRUCTURES
// ==================================================

export struct Track {
    title: string,
    artist: string,
    duration: string,
    cover: image,
}

export struct Album {
    title: string,
    artist: string,
    cover: image,
}


// ==================================================
// BUTTON
// ==================================================

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> accent: false;
    in property <bool> interactive: true;

    callback clicked();

    height: 34px;
    background: touch.pressed
        ? #424242
        : accent
            ? #e94719
            : active
                ? #383838
                : #252525;

    border-radius: 7px;

    Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;

        text: root.label;
        color: root.interactive ? #eeeeee : #666666;
        font-size: 12px;
        font-weight: 600;

        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.interactive;

        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}


// ==================================================
// ALBUM CARD
// ==================================================

component AlbumCard inherits Rectangle {
    in property <string> album-title;
    in property <string> artist;
    in property <image> cover;
    in property <bool> selected: false;

    callback opened();

    width: 104px;
    height: 120px;

    background: transparent;

    Rectangle {
        width: parent.width;
        height: 76px;

        background: #303030;
        border-radius: 7px;
        clip: true;

        Image {
            width: parent.width;
            height: parent.height;
            source: root.cover;
        }
    }

    Text {
        x: 0px;
        y: 80px;
        width: parent.width;
        height: 17px;

        text: root.album-title;
        color: #eeeeee;
        font-size: 11px;
        font-weight: 600;
        overflow: elide;
    }

    Text {
        x: 0px;
        y: 98px;
        width: parent.width;
        height: 15px;

        text: root.artist;
        color: #858585;
        font-size: 10px;
        overflow: elide;
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 76px;

        border-radius: 7px;
        border-width: root.selected ? 2px : 0px;
        border-color: #e94719;
        background: transparent;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.opened();
        }
    }
}


// ==================================================
// TRACK ROW
// ==================================================

component TrackRow inherits Rectangle {
    in property <string> track-title;
    in property <string> artist;
    in property <string> duration;
    in property <image> cover;
    in property <bool> selected: false;

    callback select-requested();
    callback play-requested();

    height: 54px;

    background: selected ? #303030 : #202020;
    border-radius: 8px;

    Rectangle {
        x: 8px;
        y: 6px;

        width: 42px;
        height: 42px;

        background: #353535;
        border-radius: 5px;
        clip: true;

        Image {
            width: parent.width;
            height: parent.height;
            source: root.cover;
        }
    }

    Text {
        x: 60px;
        y: 7px;

        width: parent.width - 165px;
        height: 18px;

        text: root.track-title;
        color: #eeeeee;
        font-size: 12px;
        font-weight: 600;
        overflow: elide;
    }

    Text {
        x: 60px;
        y: 26px;

        width: parent.width - 165px;
        height: 16px;

        text: root.artist;
        color: #929292;
        font-size: 10px;
        overflow: elide;
    }

    Text {
        x: parent.width - 115px;
        y: 0px;

        width: 55px;
        height: parent.height;

        text: root.duration;
        color: #999999;
        font-size: 10px;

        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Play track button
    ActionButton {
        x: parent.width - 53px;
        y: 10px;

        width: 34px;
        height: 34px;

        label: "▶";

        clicked => {
            root.play-requested();
        }
    }

    // Select track
    TouchArea {
        x: 0px;
        y: 0px;

        width: parent.width - 55px;
        height: parent.height;

        clicked => {
            root.select-requested();
        }
    }
}


// ==================================================
// MAIN WINDOW
// ==================================================

export component MainWindow inherits Window {
    title: "Montana";

    preferred-width: 1120px;
    preferred-height: 700px;

    min-width: 800px;
    min-height: 540px;

    background: #252d38;


    // ==================================================
    // MODELS
    // ==================================================

    in property <[Track]> tracks: [];
    in property <[Album]> albums: [];
    in property <[string]> playlists: [];
    in property <[Track]> album-tracks: [];


    // ==================================================
    // NAVIGATION STATE
    // ==================================================

    in-out property <string> active-section: "Home";
    in-out property <string> active-tab: "New Music";

    callback section-selected(string);
    callback tab-selected(string);
    callback playlist-selected(string);
    callback create-playlist-requested();


    // ==================================================
    // SEARCH
    // ==================================================

    in-out property <string> search-query: "";

    callback search-changed(string);


    // ==================================================
    // ALBUM STATE
    // ==================================================

    in-out property <int> selected-album-index: -1;

    in property <string> selected-album-title: "";
    in property <string> selected-album-artist: "";
    in property <image> selected-album-cover;

    callback album-selected(int);


    // ==================================================
    // TRACK STATE
    // ==================================================

    in-out property <int> selected-track-index: -1;

    in property <string> current-track-title: "";
    in property <string> current-track-artist: "";
    in property <image> current-track-cover;

    callback track-selected(int);
    callback play-track-requested(int);
    callback add-files-requested();


    // ==================================================
    // PLAYER STATE
    // ==================================================

    in property <bool> is-playing: false;

    in-out property <float> playhead-seconds: 0;
    in property <float> duration-seconds: 0;

    in property <string> playhead-label: "0:00";
    in property <string> duration-label: "0:00";

    callback play-pause-requested();
    callback previous-requested();
    callback next-requested();
    callback stop-requested();

    callback seek-preview(float);
    callback seek-requested(float);


    // ==================================================
    // VOLUME
    // ==================================================

    in-out property <float> volume: 0.8;

    callback volume-changed(float);


    // ==================================================
    // PLAYBACK OPTIONS
    // ==================================================

    in-out property <bool> shuffle-enabled: false;
    in-out property <bool> repeat-enabled: false;

    callback shuffle-toggled(bool);
    callback repeat-toggled(bool);


    // ==================================================
    // APPLICATION FRAME
    // ==================================================

    Rectangle {
        x: 18px;
        y: 18px;

        width: parent.width - 36px;
        height: parent.height - 36px;

        background: #111213;
        border-radius: 20px;

        clip: true;


        // ==================================================
        // LEFT SIDEBAR
        // ==================================================

        Rectangle {
            x: 0px;
            y: 0px;

            width: 182px;
            height: parent.height - 76px;

            background: #151617;


            // Application logo

            Rectangle {
                x: 18px;
                y: 20px;

                width: 34px;
                height: 34px;

                background: #e94719;
                border-radius: 9px;

                Text {
                    width: parent.width;
                    height: parent.height;

                    text: "M";
                    color: white;
                    font-size: 18px;
                    font-weight: 800;

                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                x: 62px;
                y: 20px;

                width: 110px;
                height: 34px;

                text: "MONTANA";
                color: #eeeeee;
                font-size: 12px;
                font-weight: 700;

                vertical-alignment: center;
            }


            // Main navigation

            ActionButton {
                x: 16px;
                y: 76px;

                width: 150px;

                label: "Home";
                active: root.active-section == "Home";

                clicked => {
                    root.active-section = "Home";
                    root.section-selected("Home");
                }
            }

            ActionButton {
                x: 16px;
                y: 116px;

                width: 150px;

                label: "Explore";
                active: root.active-section == "Explore";

                clicked => {
                    root.active-section = "Explore";
                    root.section-selected("Explore");
                }
            }

            ActionButton {
                x: 16px;
                y: 156px;

                width: 150px;

                label: "Equaliser";
                active: root.active-section == "Equaliser";

                clicked => {
                    root.active-section = "Equaliser";
                    root.section-selected("Equaliser");
                }
            }


            // Library

            Text {
                x: 18px;
                y: 210px;

                width: 150px;
                height: 22px;

                text: "LIBRARY";
                color: #888888;
                font-size: 11px;
                font-weight: 700;
            }

            ActionButton {
                x: 16px;
                y: 238px;

                width: 150px;
                height: 31px;

                label: "Songs";
                active: root.active-section == "Songs";

                clicked => {
                    root.active-section = "Songs";
                    root.section-selected("Songs");
                }
            }

            ActionButton {
                x: 16px;
                y: 274px;

                width: 150px;
                height: 31px;

                label: "Albums";
                active: root.active-section == "Albums";

                clicked => {
                    root.active-section = "Albums";
                    root.section-selected("Albums");
                }
            }

            ActionButton {
                x: 16px;
                y: 310px;

                width: 150px;
                height: 31px;

                label: "Artists";
                active: root.active-section == "Artists";

                clicked => {
                    root.active-section = "Artists";
                    root.section-selected("Artists");
                }
            }

            ActionButton {
                x: 16px;
                y: 346px;

                width: 150px;
                height: 31px;

                label: "Favorites";
                active: root.active-section == "Favorites";

                clicked => {
                    root.active-section = "Favorites";
                    root.section-selected("Favorites");
                }
            }


            // Playlists

            Text {
                x: 18px;
                y: 397px;

                width: 150px;
                height: 20px;

                text: "PLAYLISTS";
                color: #888888;
                font-size: 11px;
                font-weight: 700;
            }

            ActionButton {
                x: 16px;
                y: 424px;

                width: 150px;
                height: 31px;

                label: "+ Create playlist";
                accent: false;

                clicked => {
                    root.create-playlist-requested();
                }
            }

            ListView {
                x: 16px;
                y: 463px;

                width: 150px;
                height: parent.height - 540px;

                for playlist in root.playlists: ActionButton {
                    width: 150px;
                    height: 31px;

                    label: playlist;

                    clicked => {
                        root.active-section = "Playlists";
                        root.playlist-selected(playlist);
                    }
                }
            }
        }


        // Sidebar separator

        Rectangle {
            x: 182px;
            y: 0px;

            width: 1px;
            height: parent.height - 76px;

            background: #292929;
        }


        // ==================================================
        // CENTER CONTENT
        // ==================================================

        Rectangle {
            x: 183px;
            y: 0px;

            width: parent.width - 413px;
            height: parent.height - 76px;

            background: #111213;

            clip: true;


            // Top tabs

            ActionButton {
                x: 20px;
                y: 16px;

                width: 92px;

                label: "New Music";
                active: root.active-tab == "New Music";

                clicked => {
                    root.active-tab = "New Music";
                    root.tab-selected("New Music");
                }
            }

            ActionButton {
                x: 118px;
                y: 16px;

                width: 72px;

                label: "Friends";
                active: root.active-tab == "Friends";

                clicked => {
                    root.active-tab = "Friends";
                    root.tab-selected("Friends");
                }
            }

            ActionButton {
                x: 196px;
                y: 16px;

                width: 62px;

                label: "Radio";
                active: root.active-tab == "Radio";

                clicked => {
                    root.active-tab = "Radio";
                    root.tab-selected("Radio");
                }
            }


            // Search field

            Rectangle {
                x: parent.width - 252px;
                y: 17px;

                width: 232px;
                height: 32px;

                background: #191919;
                border-width: 1px;
                border-color: #543024;
                border-radius: 15px;

                LineEdit {
                    x: 10px;
                    y: 1px;

                    width: parent.width - 20px;
                    height: parent.height - 2px;

                    text <=> root.search-query;
                    placeholder-text: "Search...";
                    font-size: 12px;

                    edited(value) => {
                        root.search-changed(value);
                    }

                    accepted(value) => {
                        root.search-changed(value);
                    }
                }
            }


            // Albums heading

            Text {
                x: 20px;
                y: 65px;

                width: 250px;
                height: 28px;

                text: "New Releases";
                color: #eeeeee;
                font-size: 17px;
                font-weight: 700;
            }


            // Album list

            Rectangle {
                x: 20px;
                y: 100px;

                width: parent.width - 40px;
                height: 130px;

                clip: true;
                background: transparent;

                HorizontalLayout {
                    x: 0px;
                    y: 0px;

                    width: parent.width;
                    height: parent.height;

                    spacing: 12px;
                    alignment: start;

                    if root.albums.length == 0 : Text {
                        text: "No albums";
                        color: #777777;
                        font-size: 12px;
                    }

                    for album[index] in root.albums: AlbumCard {
                        album-title: album.title;
                        artist: album.artist;
                        cover: album.cover;

                        selected: root.selected-album-index == index;

                        opened => {
                            root.selected-album-index = index;
                            root.album-selected(index);
                        }
                    }
                }
            }


            // Tracks heading

            Text {
                x: 20px;
                y: 249px;

                width: 180px;
                height: 27px;

                text: "Tracks";
                color: #eeeeee;
                font-size: 17px;
                font-weight: 700;
            }

            ActionButton {
                x: parent.width - 113px;
                y: 247px;

                width: 93px;
                height: 30px;

                label: "+ Add files";

                clicked => {
                    root.add-files-requested();
                }
            }


            // Tracks list

            if root.tracks.length == 0 : Text {
                x: 20px;
                y: 302px;

                width: parent.width - 40px;
                height: 50px;

                text: "No tracks loaded";
                color: #777777;
                font-size: 12px;

                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.tracks.length > 0 : ListView {
                x: 20px;
                y: 283px;

                width: parent.width - 40px;
                height: parent.height - 299px;

                for track[index] in root.tracks: TrackRow {
                    width: parent.width;
                    height: 54px;

                    track-title: track.title;
                    artist: track.artist;
                    duration: track.duration;
                    cover: track.cover;

                    selected: root.selected-track-index == index;

                    select-requested => {
                        root.selected-track-index = index;
                        root.track-selected(index);
                    }

                    play-requested => {
                        root.selected-track-index = index;
                        root.track-selected(index);
                        root.play-track-requested(index);
                    }
                }
            }
        }


        // ==================================================
        // RIGHT ALBUM PANEL
        // ==================================================

        Rectangle {
            x: parent.width - 230px;
            y: 0px;

            width: 230px;
            height: parent.height - 76px;

            background: #151617;


            Rectangle {
                x: 0px;
                y: 0px;

                width: 1px;
                height: parent.height;

                background: #292929;
            }

            Text {
                x: 18px;
                y: 18px;

                width: 190px;
                height: 30px;

                text: "Albums";
                color: #eeeeee;
                font-size: 17px;
                font-weight: 700;
            }


            // Empty state

            if root.selected-album-title == "" : Text {
                x: 18px;
                y: 85px;

                width: parent.width - 36px;
                height: 80px;

                text: "Select an album";
                color: #777777;
                font-size: 12px;

                horizontal-alignment: center;
                vertical-alignment: center;
            }


            // Selected album

            if root.selected-album-title != "" : Rectangle {
                x: 16px;
                y: 57px;

                width: parent.width - 32px;
                height: 126px;

                background: #292929;
                border-radius: 11px;

                Rectangle {
                    x: 9px;
                    y: 10px;

                    width: 88px;
                    height: 88px;

                    background: #353535;
                    border-radius: 6px;
                    clip: true;

                    Image {
                        width: parent.width;
                        height: parent.height;

                        source: root.selected-album-cover;
                    }
                }

                Text {
                    x: 105px;
                    y: 25px;

                    width: parent.width - 112px;
                    height: 35px;

                    text: root.selected-album-title;
                    color: #eeeeee;
                    font-size: 11px;
                    font-weight: 700;
                    overflow: elide;
                }

                Text {
                    x: 105px;
                    y: 62px;

                    width: parent.width - 112px;
                    height: 25px;

                    text: root.selected-album-artist;
                    color: #999999;
                    font-size: 10px;
                    overflow: elide;
                }
            }


            Text {
                x: 18px;
                y: 201px;

                width: 180px;
                height: 23px;

                text: "Songs";
                color: #cccccc;
                font-size: 12px;
                font-weight: 600;
            }


            // Album tracks empty state

            if root.selected-album-title != "" && root.album-tracks.length == 0 : Text {
                x: 18px;
                y: 237px;

                width: parent.width - 36px;
                height: 55px;

                text: "No tracks in this album";
                color: #777777;
                font-size: 11px;

                horizontal-alignment: center;
                vertical-alignment: center;
            }


            // Album tracks

            if root.album-tracks.length > 0 : ListView {
                x: 18px;
                y: 230px;

                width: parent.width - 36px;
                height: parent.height - 245px;

                for track[index] in root.album-tracks: TrackRow {
                    width: parent.width;
                    height: 49px;

                    track-title: track.title;
                    artist: track.artist;
                    duration: track.duration;
                    cover: track.cover;

                    play-requested => {
                        root.play-track-requested(index);
                    }

                    select-requested => {
                        root.track-selected(index);
                    }
                }
            }
        }


        // ==================================================
        // BOTTOM PLAYER
        // ==================================================

        Rectangle {
            x: 0px;
            y: parent.height - 76px;

            width: parent.width;
            height: 76px;

            background: #222426;


            // Current track artwork

            Rectangle {
                x: 17px;
                y: 12px;

                width: 45px;
                height: 45px;

                background: #353535;
                border-radius: 5px;
                clip: true;

                Image {
                    width: parent.width;
                    height: parent.height;

                    source: root.current-track-cover;
                }
            }


            // Current track information

            Text {
                x: 72px;
                y: 14px;

                width: 180px;
                height: 18px;

                text: root.current-track-title == ""
                    ? "Nothing playing"
                    : root.current-track-title;

                color: #eeeeee;
                font-size: 11px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                x: 72px;
                y: 34px;

                width: 180px;
                height: 16px;

                text: root.current-track-artist;
                color: #909090;
                font-size: 10px;
                overflow: elide;
            }


            // Shuffle

            ActionButton {
                x: parent.width / 2 - 82px;
                y: 8px;

                width: 27px;
                height: 27px;

                label: "⇄";
                active: root.shuffle-enabled;

                clicked => {
                    root.shuffle-enabled = !root.shuffle-enabled;
                    root.shuffle-toggled(root.shuffle-enabled);
                }
            }


            // Previous

            ActionButton {
                x: parent.width / 2 - 48px;
                y: 8px;

                width: 30px;
                height: 30px;

                label: "◀";

                interactive: root.current-track-title != "";

                clicked => {
                    root.previous-requested();
                }
            }


            // Play / Pause

            ActionButton {
                x: parent.width / 2 - 10px;
                y: 5px;

                width: 38px;
                height: 38px;

                label: root.is-playing ? "Ⅱ" : "▶";
                accent: true;

                interactive: root.current-track-title != "";

                clicked => {
                    root.play-pause-requested();
                }
            }


            // Next

            ActionButton {
                x: parent.width / 2 + 36px;
                y: 8px;

                width: 30px;
                height: 30px;

                label: "▶";

                interactive: root.current-track-title != "";

                clicked => {
                    root.next-requested();
                }
            }


            // Repeat

            ActionButton {
                x: parent.width / 2 + 72px;
                y: 8px;

                width: 27px;
                height: 27px;

                label: "↻";
                active: root.repeat-enabled;

                clicked => {
                    root.repeat-enabled = !root.repeat-enabled;
                    root.repeat-toggled(root.repeat-enabled);
                }
            }


            // Current position

            Text {
                x: parent.width / 2 - 174px;
                y: 41px;

                width: 38px;
                height: 17px;

                text: root.playhead-label;
                color: #999999;
                font-size: 9px;

                vertical-alignment: center;
            }


            // Duration

            Text {
                x: parent.width / 2 + 137px;
                y: 41px;

                width: 38px;
                height: 17px;

                text: root.duration-label;
                color: #999999;
                font-size: 9px;

                horizontal-alignment: right;
                vertical-alignment: center;
            }


            // REAL SEEK SLIDER

            Slider {
                x: parent.width / 2 - 130px;
                y: 39px;

                width: 255px;
                height: 21px;

                minimum: 0;
                maximum: root.duration-seconds > 0
                    ? root.duration-seconds
                    : 1;

                value <=> root.playhead-seconds;

                step: 1;

                enabled: root.duration-seconds > 0;

                changed(value) => {
                    root.seek-preview(value);
                }

                released(value) => {
                    root.seek-requested(value);
                }
            }


            // Volume

            Text {
                x: parent.width - 172px;
                y: 22px;

                width: 25px;
                height: 25px;

                text: "◖";
                color: #aaaaaa;
                font-size: 17px;

                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Slider {
                x: parent.width - 143px;
                y: 23px;

                width: 102px;
                height: 22px;

                minimum: 0;
                maximum: 1;

                step: 0.01;

                value <=> root.volume;

                changed(value) => {
                    root.volume-changed(value);
                }
            }


            // Stop

            ActionButton {
                x: parent.width - 32px;
                y: 20px;

                width: 23px;
                height: 25px;

                label: "■";

                interactive: root.current-track-title != "";

                clicked => {
                    root.stop-requested();
                }
            }
        }
    }
}
